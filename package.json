{
  "name": "taka-plan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@vinext/cloudflare": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.5"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "vite preview --port 3001",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "cf workers types && tsc --noEmit && tsc -p packages/engine/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --persist-to .cloudflare/state --dir migrations",
    "db:migrate:remote": "cf d1 migrations apply \"$D1_DATABASE_ID\" --dir migrations",
    "db:reset:local": "rm -rf .cloudflare/state",
    "rates:gen-seed": "node scripts/gen-seed-migration.mjs",
    "smoke": "sh scripts/smoke.sh"
  },
  "description": "Taka Plan: a free Bangla/English personal-finance planner for Bangladesh",
  "engines": {
    "node": ">=24.22"
  }
}
