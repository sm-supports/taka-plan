{
  "name": "taka-plan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "node scripts/gen-region-defaults.mjs && node scripts/copy-country-data.mjs && vite build && node scripts/check-export.mjs",
    "preview": "wrangler pages dev dist/client --port 8788 --compatibility-date 2026-10-23 --d1 DB=00000000-0000-4000-8000-000000000001 --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit && tsc -p packages/engine/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:migrate:local": "wrangler d1 migrations apply taka-plan --local -c config/wrangler.local.toml --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply taka-plan --remote -c config/wrangler.remote.toml",
    "db:reset:local": "rm -rf .wrangler/state",
    "rates:gen-seed": "node scripts/gen-seed-migration.mjs",
    "smoke": "sh scripts/smoke.sh",
    "countries:gen-seed": "node scripts/gen-country-seed.mjs"
  },
  "description": "Taka Plan: a free personal-finance planner for every country, in Bangla, English and ten more languages.",
  "license": "MIT",
  "engines": {
    "node": ">=24.22"
  }
}
